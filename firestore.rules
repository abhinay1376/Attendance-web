rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@example.com';
    }
    
    // Helper function to check if user is approved
    function isApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.approved == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document; admin can read ALL users
      // Also allow any authenticated user to query by regNo/phone for uniqueness checks during registration
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if request.auth != null;
      
      // Users can create their own document during signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own document ONLY if not yet approved
      // Once approved, only admin can modify
      allow update: if request.auth != null && (
        (request.auth.uid == userId && get(/databases/$(database)/documents/users/$(userId)).data.approved != true)
          || isAdmin()
      );
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // Sections collection (public read so register page can list them)
    match /sections/{sectionId} {
      // Anyone can read sections (needed for registration dropdown)
      allow read: if true;
      
      // Only admin can write sections
      allow write: if isAdmin();
    }

    // Timetable collection
    match /timetable/{timetableId} {
      // Anyone authenticated can read timetable
      allow read: if request.auth != null;
      
      // Only admin can write timetable
      allow write: if isAdmin();
    }
    
    // Holidays collection
    match /holidays/{date} {
      // Anyone authenticated can read holidays
      allow read: if request.auth != null;
      
      // Only admin can write holidays
      allow write: if isAdmin();
    }
    
    // Attendance collection - CRITICAL APPROVAL CHECK
    match /attendance/{userId}/{document=**} {
      // Users can read their own attendance; admin can read ALL for overview
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can ONLY write attendance if they are approved
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && isApproved(userId);
    }
    
    // Audit log
    match /auditLog/{logId} {
      // Only admin can read/write audit logs
      allow read, write: if isAdmin();
    }

    // Notifications collection (admin only)
    match /notifications/{notificationId} {
      // Only admin can read notifications
      allow read: if isAdmin();
      // Anyone authenticated can create notifications (for registration)
      allow create: if request.auth != null;
      // Only admin can update/delete notifications
      allow update, delete: if isAdmin();
    }

    // OTP Codes collection (for email verification)
    match /otpCodes/{email} {
      // No read access - OTP codes should only be validated server-side
      allow read: if false;
      // Allow creation/update from server-side only (API routes)
      // In practice, these will be written by API routes using Admin SDK
      allow write: if false;
    }

    // OTP Rate Limits collection (for preventing abuse)
    match /otpRateLimits/{email} {
      // No read access - rate limits checked server-side
      allow read: if false;
      // Allow creation/update from server-side only (API routes)
      allow write: if false;
    }
  }
}
